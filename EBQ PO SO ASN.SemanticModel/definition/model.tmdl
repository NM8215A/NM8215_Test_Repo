model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// For each of the models following parameters are necessary
/// 
/// source_project – To refer the source project where the data resides.
/// billing_project – To refer the billing project.
queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Renaming Table'

	annotation PBI_QueryGroupOrder = 1

queryGroup Main

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.142.928.0 (25.04)+de52df9f0bb74ad93a80d89c52d63fe6d07e0e1b

annotation PBI_QueryOrder = ["PO SO ASN","source_project","billing_project","pbi_rename_table"]

ref table 'PO SO ASN'
ref table pbi_rename_table

ref cultureInfo en-US

